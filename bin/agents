#!/bin/bash
# agents — choose what happens to your AI agents when you close the MacBook lid.
#
#   agents keep [hours]           closing the lid keeps agents running (screen off) while
#                                 one is busy; pauses again once they have all gone idle
#                                 (hours = hard cap, default 8, 0 = no cap)
#   agents keep --always [hours]  keep running whether or not an agent is busy (default 3h)
#   agents pause                  closing the lid sleeps the Mac and agents pause (normal)
#   agents toggle                 switch between keep and pause
#   agents                        status
#   agents busy                   which agent processes count as busy (or need you) right now
#   agents wait [minutes]         how long a closed Mac stays awake for an agent that needs you
#                                 (default 3; also the cup → Settings → Wait for your answer)
#   agents remote [on|off]        Claude Code's Remote Control for new sessions, so you can answer
#                                 them from your phone; lists busy sessions that aren't connected
#   agents hotkey [keys|none]     show or set the hotkey, e.g. agents hotkey ctrl+opt+cmd+l
#   agents install                one-time: passwordless sudo for exactly two pmset commands
#   agents integrate              let Lid Agents see when Codex and OpenCode are busy, and when
#                                 Claude Code, Codex or OpenCode is stuck waiting for you
#   agents uninstall              remove everything Lid Agents installed
#   agents update                 install the latest release
#   agents version
#
# Mechanism: `pmset -a disablesleep 1` sets the kernel SleepDisabled flag, which also
# blocks lid-close sleep (caffeinate and power assertions cannot). The lid sensor still
# turns the built-in display off. A background guard reverts it when the agents go idle,
# the cap expires or the battery reaches the floor, and if the lid is shut then, sleeps the Mac.
#
# "Busy" = an agent CLI that has a caffeinate child (Claude Code holds `caffeinate -i -t 300`
# only while working; so does OpenCode with the Lid Agents plugin), holds a sleep assertion
# itself (Codex with prevent_idle_sleep), or is using >= AGENTS_CPU % CPU. An open-but-idle
# session is not busy. `agents integrate` sets up the Codex and OpenCode parts.
#
# "Needs input" = an agent that has stopped on a permission prompt or a question (reported by the
# hooks and plugin `agents integrate` installs), isn't using CPU and hasn't started anything
# since. With the lid closed it keeps the Mac awake for the wait time (default 3 minutes, enough
# to answer from a phone if you want it longer), then the Mac sleeps. With the lid open it counts
# as busy: someone may be there to answer, and keep mode shouldn't switch off mid-read.

set -u

AGENTS_VERSION="dev"
BUNDLE_ID="io.github.liam-machine.lid-agents"

STATE_DIR="$HOME/.cache/lid-agents"
GUARD_PID="$STATE_DIR/guard.pid"
KEEP_MODE="$STATE_DIR/keep-mode"               # busy or always: what the last `agents keep` chose
LOG="$STATE_DIR/lid-agents.log"
SUDOERS_FILE="/etc/sudoers.d/lid-agents"
LAUNCH_AGENT="$HOME/Library/LaunchAgents/$BUNDLE_ID.plist"
LINK="$HOME/.local/bin/agents"
OPENCODE_PLUGIN="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins/lid-agents.js"
WAITING_DIR="$STATE_DIR/waiting"               # <agent pid> files: "<epoch> <kind>", from hooks
CLAUDE_SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
HOOK_TAG="# lid-agents-hook"                   # marks the hook entries this script owns

MIN_BATTERY="${AGENTS_MIN_BATTERY:-15}"
AGENT_NAMES="${AGENTS_NAMES:-claude codex gemini aider opencode amp goose cursor-agent droid}"
CPU_THRESHOLD="${AGENTS_CPU:-5}"
IDLE_MINUTES="${AGENTS_IDLE_MINUTES:-3}"
# A "busy" signal (caffeinate child, sleep assertion) with almost no CPU across the agent and its
# children for this long means it's waiting on the user (an approval prompt) or an idle event
# was missed, so the guard pauses rather than keep a closed Mac awake until the cap.
QUIET_MINUTES="${AGENTS_QUIET_MINUTES:-30}"
QUIET_CPU="${AGENTS_QUIET_CPU:-1}"
DEFAULT_HOURS="${AGENTS_HOURS:-8}"
DEFAULT_WAIT_MINUTES=3
# A process an agent started after it was marked as waiting, alive at least this long, means the
# prompt was answered and a tool is running (statusline and hook commands are shorter-lived)
NEW_CHILD_SECONDS=10
HOOK_FILES="$STATE_DIR/hook-files"             # every settings/hooks file integrate edited

# Minutes a closed Mac stays awake for an agent that needs input. Read on every guard pass, so
# the menu bar's "Wait for your answer" choice applies to a keep that's already running.
wait_minutes() {
  local v="${AGENTS_WAIT_MINUTES:-}"
  [ -n "$v" ] || v="$(defaults read "$BUNDLE_ID" WaitMinutes 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) v="$DEFAULT_WAIT_MINUTES" ;; esac
  echo "$v"
}

KEEP_TEXT="Lid closed → agents keep running"
PAUSE_TEXT="Lid closed → Mac sleeps, agents pause"

# The app bundle this script ships in (empty when run from a source checkout)
SELF="$0"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
APP_BUNDLE="${SELF%/Contents/Resources/agents}"
[ "$APP_BUNDLE" = "$SELF" ] && APP_BUNDLE=""

# The OpenCode plugin ships next to this script in the app, or in integrations/ in a checkout
if [ -n "$APP_BUNDLE" ]; then
  OPENCODE_PLUGIN_SRC="$APP_BUNDLE/Contents/Resources/opencode-lid-agents.js"
else
  OPENCODE_PLUGIN_SRC="$(dirname "$SELF")/../integrations/opencode/lid-agents.js"
fi

mkdir -p "$STATE_DIR"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }

keeping() {
  # pmset only prints SleepDisabled when it is set
  [ "$(pmset -g | awk '/SleepDisabled/ {print $2}')" = "1" ]
}

# -l only lists (never runs); -k ignores cached credentials so a recent sudo can't fake it
has_sudo_rule() { sudo -k -n -l /usr/bin/pmset -a disablesleep 0 >/dev/null 2>&1; }

set_flag() { sudo -n /usr/bin/pmset -a disablesleep "$1"; }

battery_line() { pmset -g batt; }
on_battery() { battery_line | grep -q "'Battery Power'"; }
battery_pct() { battery_line | grep -Eo '[0-9]+%' | head -1 | tr -d '%'; }

lid_closed() { ioreg -r -k AppleClamshellState -d 1 | grep -q '"AppleClamshellState" = Yes'; }

guard_running() { [ -f "$GUARD_PID" ] && kill -0 "$(cat "$GUARD_PID")" 2>/dev/null; }

# PIDs holding a power assertion that stops idle sleep, one per line. Codex holds one in its
# own process while a turn runs (`codex features enable prevent_idle_sleep`).
sleep_assertion_pids() {
  pmset -g assertions 2>/dev/null | sed -nE \
    's/^[[:space:]]*pid ([0-9]+)\(.*\): \[[^]]*\] [0-9:]+ (PreventUserIdleSystemSleep|PreventSystemSleep|NoIdleSleepAssertion) .*/\1/p'
}

# Every process: "pid ppid %cpu elapsed-seconds command"
proc_table() {
  ps -axo pid=,ppid=,pcpu=,etime=,comm= | awk '{
    t = $4; s = 0; d = 0
    if (index(t, "-")) { split(t, dt, "-"); d = dt[1]; t = dt[2] }
    n = split(t, hms, ":"); for (i = 1; i <= n; i++) s = s * 60 + hms[i]
    $4 = s + d * 86400; print }'
}

# Descendants of <pid> that aren't caffeinate, comma-separated (the snapshot `mark waiting` keeps)
descendants() {   # descendants <pid> [proc table]
  printf '%s\n' "${2:-$(proc_table)}" | awk -v root="$1" '
    { pp[$1] = $2; c = $5; for (i = 6; i <= NF; i++) c = c " " $i; sub(/.*\//, "", c); nm[$1] = c
      if ($1 != $2) kids[$2] = kids[$2] " " $1 }
    function walk(p, depth,    n, i, k) {
      if (depth > 32) return
      n = split(kids[p], k, " ")
      for (i = 1; i <= n; i++) { if (nm[k[i]] != "caffeinate") out = out (out == "" ? "" : ",") k[i]; walk(k[i], depth + 1) }
    }
    END { walk(root, 0); print out }'
}

# "waiting <pid> <descendants when marked>" for each agent a hook or the OpenCode plugin marked as
# stopped on a prompt. Markers (and clear stamps) of agents that have exited are removed here.
waiting_pids() {
  local f pid snap
  [ -d "$WAITING_DIR" ] || return 0
  for f in "$WAITING_DIR"/* "$WAITING_DIR"/.clear-*; do
    [ -f "$f" ] || continue
    pid="${f##*/}"; pid="${pid#.clear-}"
    case "$pid" in ''|*[!0-9]*) rm -f "$f"; continue ;; esac
    if ! kill -0 "$pid" 2>/dev/null; then rm -f "$f"; continue; fi
    case "$f" in */.clear-*) continue ;; esac
    snap="$(sed -n 2p "$f" 2>/dev/null)"
    echo "waiting $pid ${snap:--}"
  done
}

# Prints "pid name why why cpu" for every agent that's busy or needs input. Names match the
# executable's basename exactly, so the Claude desktop app ("Claude") and its helpers never count.
# Agents installed through npm, bun or pip run as node/bun/python, so for those the script name in
# the command line counts instead (`node /opt/homebrew/bin/gemini` is gemini). None of this
# depends on which terminal or app started the agent. An agent is busy when:
#   - it has a caffeinate child: Claude Code while working, OpenCode with the Lid Agents plugin
#   - it holds a sleep assertion itself: Codex with prevent_idle_sleep on
#   - it and its child processes use >= AGENTS_CPU % CPU together: anything else, including
#     an agent whose work runs in children (a long test suite, `codex exec`)
# It "needs input" instead when it's marked as waiting on a prompt, its process tree is under
# AGENTS_CPU, and nothing it started since the mark has run for NEW_CHILD_SECONDS (if it has,
# the prompt was answered and an approved tool is running, whatever the marker still says).
INTERPRETERS='^(node|bun|deno|python[0-9.]*|Python|ruby)$'
agent_report() {
  local procs scan interp=""
  procs="$(proc_table)"
  # One cheap pass first: is any agent (or interpreter that might be one) running at all?
  scan="$(printf '%s\n' "$procs" | awk -v names="$AGENT_NAMES" -v interp="$INTERPRETERS" '
    BEGIN { n = split(names, a, " "); for (i = 1; i <= n; i++) want[a[i]] = 1 }
    { c = $5; for (i = 6; i <= NF; i++) c = c " " $i; sub(/.*\//, "", c)
      if (c in want) found = 1
      if (c ~ interp) { found = 1; pids = pids (pids == "" ? "" : ",") $1 } }
    END { print (found ? "yes" : "no"), pids }')"
  [ "${scan%% *}" = "yes" ] || return 0
  interp="${scan#* }"
  {
    printf '%s\n' "$procs"
    # Full command lines only for interpreter processes, never every process on the Mac
    if [ -n "$interp" ]; then ps -ww -o pid=,args= -p "$interp" 2>/dev/null | sed 's/^ */args /'; fi
    sleep_assertion_pids | sed 's/^/assertion /'
    waiting_pids
  } |
  awk -v names="$AGENT_NAMES" -v thr="$CPU_THRESHOLD" -v interp="$INTERPRETERS" -v fresh="$NEW_CHILD_SECONDS" '
    function base(s) { sub(/.*\//, "", s); return s }
    # CPU of a process plus all its descendants (depth-limited against pid reuse cycles)
    function tree_cpu(p, depth,    total, n, i, kid) {
      total = cpu[p] + 0
      if (depth > 32) return total
      n = split(kids[p], kid, " ")
      for (i = 1; i <= n; i++) total += tree_cpu(kid[i], depth + 1)
      return total
    }
    # A descendant started after the mark (not in the snapshot) that has lived >= fresh seconds
    function started_since(p, snap, depth,    n, i, kid) {
      if (depth > 32) return 0
      n = split(kids[p], kid, " ")
      for (i = 1; i <= n; i++) {
        if (name[kid[i]] != "caffeinate" && !index(snap, "," kid[i] ",") && age[kid[i]] >= fresh) return 1
        if (started_since(kid[i], snap, depth + 1)) return 1
      }
      return 0
    }
    BEGIN { n = split(names, a, " "); for (i = 1; i <= n; i++) want[a[i]] = 1 }
    $1 == "assertion" { asserted[$2] = 1; next }
    $1 == "waiting" { waiting[$2] = "," $3 ","; next }
    $1 == "args" {
      pid = $2
      if (!(pid in name) || name[pid] !~ interp) next
      # argv[0] (a process title such as "claude"), else the first non-flag argument
      for (i = 3; i <= NF; i++) {
        if (i > 3 && $i ~ /^-/) continue
        if (base($i) in want) { name[pid] = base($i); agent[pid] = 1; break }
        if (i > 3) break
      }
      next
    }
    {
      pid = $1; ppid[pid] = $2; cpu[pid] = $3; age[pid] = $4
      if (pid != $2) kids[$2] = kids[$2] " " pid
      comm = $5; for (i = 6; i <= NF; i++) comm = comm " " $i
      name[pid] = base(comm)
      if (name[pid] in want) agent[pid] = 1
    }
    END {
      for (p in agent) total[p] = tree_cpu(p, 0)
      for (p in name) if (name[p] == "caffeinate" && (ppid[p] in agent)) why[ppid[p]] = "caffeinate child"
      for (p in agent) if (!(p in why) && (p in asserted)) why[p] = "sleep assertion"
      for (p in agent) if (!(p in why) && total[p] >= thr) why[p] = sprintf("cpu %.1f%%", total[p])
      for (p in agent)
        if ((p in waiting) && total[p] < thr && !started_since(p, waiting[p], 0)) why[p] = "needs input"
      for (p in why) print p, name[p], why[p], sprintf("%.1f", total[p])
    }'
}

# "pid name why" per busy agent (not counting ones that need input); --cpu adds the combined CPU %
busy_agents() {
  if [ "${1:-}" = "--cpu" ]; then agent_report | awk '$3 " " $4 != "needs input"'
  else agent_report | awk '$3 " " $4 != "needs input" { print $1, $2, $3, $4 }'; fi
}

busy_count() { busy_agents | wc -l | tr -d ' '; }

need_rule() {
  has_sudo_rule && return 0
  echo "agents: setup is incomplete. Run:  agents install" >&2
  exit 1
}

stop_guard() {
  if [ -f "$GUARD_PID" ]; then
    kill "$(cat "$GUARD_PID")" 2>/dev/null
    rm -f "$GUARD_PID"
  fi
}

start_guard() {
  local mode="$1" hours="$2"
  local deadline=0
  if [ "$hours" != "0" ]; then
    deadline=$(( $(date +%s) + $(awk "BEGIN {printf \"%d\", $hours * 3600}") ))
  fi
  (
    trap 'exit 0' TERM
    idle=0
    quiet=0
    waited=0
    while sleep 60; do
      keeping || exit 0                             # paused elsewhere
      reason=""
      if [ "$deadline" -gt 0 ] && [ "$(date +%s)" -ge "$deadline" ]; then
        reason="cap (${hours}h) reached"
      elif on_battery && [ "$(battery_pct)" -le "$MIN_BATTERY" ]; then
        reason="battery at $(battery_pct)% (floor ${MIN_BATTERY}%)"
      elif [ "$mode" = "busy" ]; then
        report="$(agent_report)"
        if lid_closed; then
          busy="$(printf '%s\n' "$report" | awk 'NF && $3 " " $4 != "needs input"')"
          waiting="$(printf '%s\n' "$report" | awk 'NF && $3 " " $4 == "needs input"')"
        else
          # Lid open: someone may be there to answer, so a prompt counts as busy
          busy="$report"; waiting=""
        fi
        if [ -n "$busy" ]; then
          idle=0; waited=0
          # every busy agent is near 0% CPU (with its children): waiting, not working
          if printf '%s\n' "$busy" | awk -v q="$QUIET_CPU" '$NF + 0 >= q { active = 1 } END { exit active }'; then
            quiet=$((quiet + 1))
          else
            quiet=0
          fi
        elif [ -n "$waiting" ]; then
          idle=0; quiet=0; waited=$((waited + 1))
        else
          idle=$((idle + 1)); quiet=0; waited=0
        fi
        wait_for="$(wait_minutes)"
        if [ "$idle" -ge "$IDLE_MINUTES" ]; then
          reason="no agent busy for ${IDLE_MINUTES} min"
        elif [ "$waited" -ge "$wait_for" ]; then
          reason="an agent needed you for ${wait_for} min with the lid closed"
        elif [ "$quiet" -ge "$QUIET_MINUTES" ]; then
          reason="agents waiting with no activity for ${QUIET_MINUTES} min (probably on you)"
        fi
      fi
      if [ -n "$reason" ]; then
        if set_flag 0; then
          log "auto-pause: $reason"
          # the lid-close event already happened, so nothing else would sleep the Mac now
          if lid_closed; then log "lid closed: sleeping now"; pmset sleepnow >/dev/null; fi
        fi
        rm -f "$GUARD_PID"
        exit 0
      fi
    done
  ) >/dev/null 2>&1 &
  echo $! > "$GUARD_PID"
  disown
}

cmd_keep() {
  local mode="busy" hours=""
  if [ "${1:-}" = "--always" ]; then mode="always"; shift; fi
  hours="${1:-}"; hours="${hours%h}"
  if [ -z "$hours" ]; then
    if [ "$mode" = "always" ]; then hours=3; else hours="$DEFAULT_HOURS"; fi
  fi
  case "$hours" in ''|*[!0-9.]*) echo "agents: hours must be a number, got '$1'" >&2; exit 1 ;; esac

  need_rule
  set_flag 1 || exit 1
  stop_guard
  start_guard "$mode" "$hours"
  echo "$mode" > "$KEEP_MODE"
  log "keep (mode=$mode, cap=${hours}h, floor=${MIN_BATTERY}%)"

  local cap="cap ${hours}h"; [ "$hours" = "0" ] && cap="no cap"
  local busy; busy="$(busy_count)"
  echo "$KEEP_TEXT"
  if [ "$mode" = "always" ]; then
    echo "  …whether or not they're busy ($cap, battery floor ${MIN_BATTERY}%)."
  elif [ "$busy" = "0" ]; then
    echo "  …but none is busy right now: pauses again in ~${IDLE_MINUTES} min unless one starts."
  else
    echo "  …while they're busy: $busy now ($cap, battery floor ${MIN_BATTERY}%). Close the lid whenever."
  fi
  local missing; missing="$(remote_missing)"
  if [ -n "$missing" ]; then
    echo "  Not on Remote Control: $(printf '%s\n' "$missing" | remote_missing_names). To answer from your phone, run /remote-control in each before you close the lid."
  fi
  if on_battery; then echo "  On battery ($(battery_pct)%): keep it out of a bag, it can't vent with the lid shut."; fi
}

cmd_pause() {
  need_rule
  stop_guard
  set_flag 0 || exit 1
  log "pause"
  echo "$PAUSE_TEXT"
}

cmd_status() {
  if keeping; then
    echo "$KEEP_TEXT"
    local how; how="$(grep ' keep (' "$LOG" 2>/dev/null | tail -1 | sed 's/.* keep (//; s/)$//')"
    if guard_running; then
      echo "  guard:   watching ($how)"
    else
      echo "  guard:   NOT running, so nothing will pause it automatically (agents pause)"
    fi
  else
    echo "$PAUSE_TEXT"
  fi
  local report; report="$(agent_report)"
  echo "  busy:    $(printf '%s\n' "$report" | awk 'NF && $3 " " $4 != "needs input"' | wc -l | tr -d ' ') agent(s)"
  echo "  waiting: $(printf '%s\n' "$report" | awk 'NF && $3 " " $4 == "needs input"' | wc -l | tr -d ' ') need you · a closed Mac stays awake $(wait_minutes) min for an answer (agents wait)"
  echo "  battery: $(battery_pct)% $(on_battery && echo '(on battery)' || echo '(on AC)') · lid $(lid_closed && echo closed || echo open)"
  echo "  hotkey:  $(current_hotkey)"
  if [ -d "$(dirname "$(claude_settings_file)")" ]; then
    local missing remote; missing="$(remote_missing "$report")"
    remote="$(remote_on && echo on || echo off) for new Claude sessions (agents remote)"
    if [ -n "$missing" ]; then
      remote="$remote · busy, not connected: $(printf '%s\n' "$missing" | remote_missing_names) (run /remote-control in each)"
    fi
    echo "  remote:  $remote"
  fi
  if ! pgrep -x LidAgents >/dev/null; then
    echo "  app:     not running (open Lid Agents from Applications or Spotlight)"
  fi
  if [ "$(cat "$STATE_DIR/notifications" 2>/dev/null)" = "denied" ]; then
    echo "  notices: off, so switching shows no banner. System Settings → Notifications → Lid Agents"
  fi
  if ! has_sudo_rule; then echo "  setup:   incomplete (agents install)"; fi
  if [ -f "$LOG" ]; then echo "  last:    $(tail -1 "$LOG")"; fi
}

# The keep mode cmd_keep last started: busy (while agents work) or always (whether or not)
keep_mode() { cat "$KEEP_MODE" 2>/dev/null || echo busy; }

# One machine-readable line for the menu bar app:
#   <keep|pause> <busy> <guard 0|1> <battery%> <ac|battery> <open|closed> <setup ok|missing> <idle minutes>
#   <busy|always>
# --menu adds, from the same agent report, what the menu lists:
#   remote <on|off|none>              Remote Control for new Claude sessions (none: no Claude Code here)
#   agent <pid> <name> <working|waiting> <yes|no|-> <folder>   yes|no: a Claude session on Remote Control
cmd_state() {
  local report; report="$(agent_report)"
  printf '%s %s %s %s %s %s %s %s %s\n' \
    "$(keeping && echo keep || echo pause)" "$(printf '%s\n' "$report" | awk 'NF && $3 " " $4 != "needs input"' | wc -l | tr -d ' ')" \
    "$(guard_running && echo 1 || echo 0)" "$(battery_pct)" "$(on_battery && echo battery || echo ac)" \
    "$(lid_closed && echo closed || echo open)" "$(has_sudo_rule && echo ok || echo missing)" "$IDLE_MINUTES" "$(keep_mode)"
  [ "${1:-}" = "--menu" ] || return 0
  local remote="none" sessions="" pid name why1 why2 state phone
  if [ -d "$(dirname "$(claude_settings_file)")" ]; then
    remote="$(remote_on && echo on || echo off)"
    sessions="$(remote_sessions "$report")"
  fi
  echo "remote $remote"
  printf '%s\n' "$report" | while read -r pid name why1 why2 _; do
    [ -n "$pid" ] || continue
    state=working; [ "$why1 $why2" = "needs input" ] && state=waiting
    phone="$(printf '%s\n' "$sessions" | awk -v p="$pid" '$1 == p { print $2 }')"
    echo "agent $pid $name $state ${phone:--} $(agent_folder "$pid")"
  done
}

agent_folder() { lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p'; }

# Busy agents first, then any that need input ("needs input" is the why the app looks for)
cmd_busy() {
  local out
  out="$(agent_report | awk '{ print ($3 " " $4 == "needs input" ? 1 : 0), $1, $2, $3, $4 }' | sort -s -k1,1n | cut -d' ' -f2-)"
  if [ -z "$out" ]; then echo "No busy agents (watching: $AGENT_NAMES)"; return 0; fi
  echo "$out" | while read -r pid name why1 why2; do
    printf '%-7s %-10s %-16s %s\n' "$pid" "$name" "$why1 $why2" "$(agent_folder "$pid")"
  done
}

# The agent process at or above <pid>: the hooks pass their shell's parent, which is the agent
# itself, but a wrapper in between is fine too. Interpreter processes count by their command line.
agent_ancestor() {
  local chain pid name
  chain="$(proc_table | awk -v start="$1" '
    { pp[$1] = $2; c = $5; for (i = 6; i <= NF; i++) c = c " " $i; sub(/.*\//, "", c); nm[$1] = c }
    END { p = start; for (d = 0; d < 16 && (p in nm); d++) { print p, nm[p]; if (pp[p] == p) break; p = pp[p] } }')"
  while read -r pid name; do
    [ -n "$pid" ] || continue
    case " $AGENT_NAMES " in *" $name "*) echo "$pid"; return 0 ;; esac
    if printf '%s' "$name" | grep -Eq "$INTERPRETERS"; then
      # same rule as agent_report: process title, else the first non-flag argument
      if ps -ww -o pid=,args= -p "$pid" 2>/dev/null | awk -v names="$AGENT_NAMES" '
          BEGIN { n = split(names, a, " "); for (i = 1; i <= n; i++) want[a[i]] = 1 }
          { for (i = 2; i <= NF; i++) { if (i > 2 && $i ~ /^-/) continue; b = $i; sub(/.*\//, "", b)
              if (b in want) { f = 1; exit } ; if (i > 2) exit } }
          END { exit !f }'; then echo "$pid"; return 0; fi
    fi
  done <<< "$chain"
  return 1
}

# agents mark waiting|working [--pid N] [--kind permission|question]
# Called by the hooks `agents integrate` installs: waiting when an agent stops on a prompt,
# working on its next event. Quiet and always exits 0, so it can never upset an agent.
cmd_mark() {
  local what="${1:-}" pid="" kind="input" agent
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --pid) pid="${2:-}"; shift 2 || break ;;
      --kind) kind="${2:-input}"; shift 2 || break ;;
      *) shift ;;
    esac
  done
  case "$kind" in permission|question|input) ;; *) kind="input" ;; esac
  pid="${pid:-$PPID}"
  # The directory must exist before the slow part, so a clear hook that fires meanwhile leaves
  # its stamp (hook_clear_cmd only stamps when the directory is there)
  mkdir -p "$WAITING_DIR"
  local started procs; started="$(date +%s)"
  agent="$(agent_ancestor "$pid")" || return 0
  case "$what" in
    waiting)
      procs="$(proc_table)"
      printf '%s %s\n%s\n' "$started" "$kind" "$(descendants "$agent" "$procs")" > "$WAITING_DIR/$agent"
      # A clear stamped at or after our start means the prompt was already answered: drop the mark
      local stamp p
      for p in "$pid" "$agent"; do
        stamp="$WAITING_DIR/.clear-$p"
        if [ -f "$stamp" ] && [ "$(stat -f %m "$stamp")" -ge "$started" ]; then rm -f "$WAITING_DIR/$agent"; fi
      done
      ;;
    working) rm -f "$WAITING_DIR/$agent" "$WAITING_DIR/$pid"; : > "$WAITING_DIR/.clear-$agent" ;;
  esac
  return 0
}

# Runs a shell command as root: sudo when there is a terminal to ask in, the macOS admin
# dialog otherwise (GUI-launched shells and Claude Code's `!` prompt have no TTY).
as_root() {
  if (: </dev/tty) 2>/dev/null; then
    sudo /bin/sh -c "$1"
  else
    osascript -e "do shell script \"$1\" with administrator privileges" >/dev/null
  fi
}

cmd_install() {
  if has_sudo_rule; then echo "pmset rule already installed."; return 0; fi
  local user rule tmp
  user="$(id -un)"
  rule="$user ALL=(root) NOPASSWD: /usr/bin/pmset -a disablesleep 0, /usr/bin/pmset -a disablesleep 1"
  tmp="$(mktemp)"
  echo "$rule" > "$tmp"
  if ! visudo -cf "$tmp" >/dev/null; then echo "agents: generated rule failed visudo" >&2; rm -f "$tmp"; exit 1; fi
  echo "Installing $SUDOERS_FILE (your password, once):"
  echo "  $rule"
  as_root "install -m 0440 -o root -g wheel '$tmp' '$SUDOERS_FILE'" || { rm -f "$tmp"; exit 1; }
  rm -f "$tmp"
  has_sudo_rule && echo "Done." || { echo "agents: the rule did not take effect" >&2; exit 1; }
}

cmd_update() {
  local repo="liam-machine/lid-agents" latest
  latest="$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" \
    | sed -n 's/.*"tag_name": *"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' | head -1)"
  if [ -z "$latest" ]; then echo "agents: couldn't reach GitHub to check for updates" >&2; exit 1; fi
  if [ "$latest" = "$AGENTS_VERSION" ]; then echo "Lid Agents is up to date ($latest)."; return 0; fi
  echo "Updating Lid Agents $AGENTS_VERSION → $latest"
  curl -fsSL "https://github.com/$repo/releases/download/v$latest/install.sh" | LID_AGENTS_VERSION="$latest" bash
}

current_hotkey() { defaults read "$BUNDLE_ID" Hotkey 2>/dev/null || echo "ctrl+0"; }

# The menu bar app picks a changed Hotkey default up within a few seconds, no restart needed
cmd_hotkey() {
  local spec="${1:-}"
  if [ -z "$spec" ]; then
    echo "Hotkey: $(current_hotkey)"
    echo "  change it: agents hotkey ctrl+opt+cmd+l   (⌃, ⌥ or ⌘ plus a letter, number or space; or none)"
    return 0
  fi
  spec="$(printf '%s' "$spec" | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
  if [ "$spec" != "none" ]; then
    if ! printf '%s' "$spec" | grep -Eq '^((ctrl|control|opt|option|alt|shift|cmd|command)\+)+([a-z0-9]|space)$' \
       || ! printf '%s' "$spec" | grep -Eq '(^|\+)(ctrl|control|opt|option|alt|cmd|command)\+'; then
      echo "agents: '$1' isn't a hotkey. Use ⌃, ⌥ or ⌘ with a letter, number or space, e.g. ctrl+opt+cmd+l" >&2
      exit 1
    fi
  fi
  defaults write "$BUNDLE_ID" Hotkey "$spec"
  # The stamp makes the app re-apply even an unchanged spec, so re-running retries one that failed
  defaults write "$BUNDLE_ID" HotkeyRequested -float "$(date +%s)"
  if pgrep -x LidAgents >/dev/null; then
    echo "Hotkey: $spec. The menu bar app switches to it within a few seconds."
  else
    echo "Hotkey: $spec. It applies when Lid Agents next opens."
  fi
}

# Every Codex home that exists, once each: $CODEX_HOME, ~/.codex, and the one Superset launches
# Codex with. prevent_idle_sleep is a per-home setting, so integrate and uninstall share this.
codex_homes() {
  local home seen=""
  while IFS= read -r home; do
    [ -n "$home" ] && [ -d "$home" ] || continue
    case "$seen" in *"|$home|"*) continue ;; esac
    seen="$seen|$home|"
    printf '%s\n' "$home"
  done <<EOF
${CODEX_HOME:-}
$HOME/.codex
$(cat "$HOME/.superset/state/default-codex-home" 2>/dev/null)
EOF
}

codex_sleep_feature_on() {   # codex_sleep_feature_on <home>
  [ "$(CODEX_HOME="$1" codex features list 2>/dev/null | awk '$1 == "prevent_idle_sleep" {print $NF}')" = "true" ]
}

# Copies the bundled OpenCode plugin over an installed one, so upgrades (install.sh, the app's
# Update item, or dragging a new app out of the DMG) never leave an old plugin loaded.
refresh_opencode_plugin() {
  [ -f "$OPENCODE_PLUGIN" ] && [ -f "$OPENCODE_PLUGIN_SRC" ] || return 0
  cmp -s "$OPENCODE_PLUGIN_SRC" "$OPENCODE_PLUGIN" && return 0
  cp "$OPENCODE_PLUGIN_SRC" "$OPENCODE_PLUGIN" && log "refreshed OpenCode plugin"
}

# Hook commands. They run in a shell whose parent is the agent ($PPID), print nothing and
# always succeed. Clearing is pure shell (no `agents`): it removes the agent's mark and leaves a
# stamp, so a slower `mark waiting` that started before it knows it lost the race.
hook_wait_cmd() {   # hook_wait_cmd <kind>
  printf '%s' "A=\"\$HOME/.local/bin/agents\"; [ -x \"\$A\" ] && \"\$A\" mark waiting --pid \"\$PPID\" --kind $1 >/dev/null 2>&1; true $HOOK_TAG"
}
hook_clear_cmd() {
  printf '%s' "d=\"\$HOME/.cache/lid-agents/waiting\"; [ -d \"\$d\" ] && { rm -f \"\$d/\$PPID\"; : > \"\$d/.clear-\$PPID\"; } 2>/dev/null; true $HOOK_TAG"
}

# Safe reads and writes for the JSON settings files this script edits, shared by the editors below
read -r -d '' JSON_FILE_JXA <<'JXA'
const fm = $.NSFileManager.defaultManager;
function readObject(path) {
  let data = {}, before = null, perms = null;
  if (fm.fileExistsAtPath(path)) {
    // Unreadable or not UTF-8: fail and leave the file alone (never replace it with just our part)
    const raw = $.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, null);
    if (raw.isNil()) throw new Error("couldn't read " + path);
    const text = ObjC.unwrap(raw);
    if (text.trim()) data = JSON.parse(text);           // invalid JSON: fail, leave the file alone
    if (!data || typeof data !== "object" || Array.isArray(data)) throw new Error("not a JSON object: " + path);
    before = JSON.stringify(data);
    const attrs = fm.attributesOfItemAtPathError(path, null);
    if (!attrs.isNil()) perms = attrs.objectForKey($.NSFilePosixPermissions);
  }
  return { data, before, perms };
}
function writeObject(path, file) {
  // Nothing to change (the usual case at each app launch): don't rewrite the user's file
  if (file.before !== null && JSON.stringify(file.data) === file.before) return "unchanged";
  const ok = $(JSON.stringify(file.data, null, 2) + "\n").writeToFileAtomicallyEncodingError(path, true, $.NSUTF8StringEncoding, null);
  if (!ok) throw new Error("couldn't write " + path);
  // The atomic write makes a new file: give it the old one's permissions (e.g. 600 with API keys)
  if (file.perms && !file.perms.isNil()) {
    fm.setAttributesOfItemAtPathError($.NSDictionary.dictionaryWithObjectForKey(file.perms, $.NSFilePosixPermissions), path, null);
  }
  return "ok";
}
JXA

# Prints the file a symlinked <file> points to, after keeping a .lid-agents.bak copy of it before
# this script's first change
json_file_target() {   # json_file_target <file>
  local file="$1"
  while [ -L "$file" ]; do
    case "$(readlink "$file")" in /*) file="$(readlink "$file")" ;; *) file="$(dirname "$file")/$(readlink "$file")" ;; esac
  done
  mkdir -p "$(dirname "$file")"
  if [ -f "$file" ] && [ ! -e "$file.lid-agents.bak" ]; then cp -p "$file" "$file.lid-agents.bak"; fi
  printf '%s\n' "$file"
}

# Claude Code and Codex share the hooks JSON shape: { hooks: { Event: [ { matcher?, hooks: [
# { type: "command", command } ] } ] } }. Rewrites <file> without this script's entries, then
# (add) with the ones in <spec>, lines of "Event<TAB>matcher<TAB>command". Everything else in
# the file is kept; the first change leaves a .lid-agents.bak copy next to it.
edit_hooks_json() {   # edit_hooks_json <file> add|remove [spec]
  local file="$1" mode="$2" spec="${3:-}"
  if [ "$mode" = "remove" ] && { [ ! -f "$file" ] || ! grep -qF "$HOOK_TAG" "$file"; }; then return 0; fi
  file="$(json_file_target "$file")"
  { printf '%s\n' "$JSON_FILE_JXA"; cat <<'JXA'; } | osascript -l JavaScript - "$file" "$mode" "$HOOK_TAG" "$spec" >/dev/null || return 1
function run(argv) {
  const [path, mode, tag, spec] = argv;
  const file = readObject(path), data = file.data;
  const hooks = (data.hooks && typeof data.hooks === "object") ? data.hooks : {};
  const ours = (h) => h && typeof h.command === "string" && h.command.includes(tag);
  for (const event of Object.keys(hooks)) {
    if (!Array.isArray(hooks[event])) continue;
    hooks[event] = hooks[event].filter((group) => {
      if (!group || !Array.isArray(group.hooks) || !group.hooks.some(ours)) return true;
      group.hooks = group.hooks.filter((h) => !ours(h));
      return group.hooks.length > 0;
    });
    if (hooks[event].length === 0) delete hooks[event];
  }
  if (mode === "add") {
    for (const line of spec.split("\n")) {
      if (!line) continue;
      const [event, matcher, command] = line.split("\t");
      const group = { hooks: [{ type: "command", command }] };
      if (matcher) group.matcher = matcher;
      (hooks[event] = hooks[event] || []).push(group);
    }
  }
  if (Object.keys(hooks).length) data.hooks = hooks; else delete data.hooks;
  return writeObject(path, file);
}
JXA
  if [ "$mode" = "add" ] && ! grep -qxF "$file" "$HOOK_FILES" 2>/dev/null; then echo "$file" >> "$HOOK_FILES"; fi
}

# Sets top-level keys in a Claude Code settings file, each "key=<JSON value>"; "?key=value" only
# sets a key the file doesn't have yet, so a choice the user made stays. Same safety as the hooks.
set_claude_settings() {   # set_claude_settings <file> [?]key=value...
  local file; file="$(json_file_target "$1")"; shift
  { printf '%s\n' "$JSON_FILE_JXA"; cat <<'JXA'; } | osascript -l JavaScript - "$file" "$@" >/dev/null 2>&1
function run(argv) {
  const [path, ...pairs] = argv;
  const file = readObject(path);
  for (let pair of pairs) {
    const onlyUnset = pair.startsWith("?");
    if (onlyUnset) pair = pair.slice(1);
    const at = pair.indexOf("="), key = pair.slice(0, at);
    if (onlyUnset && Object.prototype.hasOwnProperty.call(file.data, key)) continue;
    file.data[key] = JSON.parse(pair.slice(at + 1));
  }
  return writeObject(path, file);
}
JXA
}

# Files that may hold our hooks: the ones integrate recorded (so a custom CLAUDE_CONFIG_DIR is
# still found from the app, which doesn't inherit it) plus the default locations
hook_files() {
  {
    cat "$HOOK_FILES" 2>/dev/null
    echo "$CLAUDE_SETTINGS"
    codex_homes | sed 's|$|/hooks.json|'
  } | awk 'NF && !seen[$0]++'
}

# Claude Code: Notification fires once the prompt is on screen (permission, MCP elicitation,
# a background agent's question); the clear events are its next signs of life.
claude_hook_spec() {
  local wait clear e
  wait="$(hook_wait_cmd permission)"; clear="$(hook_clear_cmd)"
  printf 'Notification\tpermission_prompt|worker_permission_prompt\t%s\n' "$wait"
  printf 'Notification\telicitation_dialog|elicitation_url_dialog|agent_needs_input\t%s\n' "$(hook_wait_cmd question)"
  for e in UserPromptSubmit PostToolUse PostToolUseFailure ElicitationResult Stop StopFailure SessionEnd; do
    printf '%s\t\t%s\n' "$e" "$clear"
  done
}

# Codex: PermissionRequest for approvals, request_user_input for its questions
codex_hook_spec() {
  local clear e
  clear="$(hook_clear_cmd)"
  printf 'PermissionRequest\t\t%s\n' "$(hook_wait_cmd permission)"
  printf 'PreToolUse\t^request_user_input$\t%s\n' "$(hook_wait_cmd question)"
  for e in UserPromptSubmit PostToolUse Stop Interrupt SessionEnd; do
    printf '%s\t\t%s\n' "$e" "$clear"
  done
}

# Installs this script's hooks for Claude Code and every Codex home
integrate_hooks() {
  local home
  if command -v claude >/dev/null 2>&1 || [ -d "$(dirname "$CLAUDE_SETTINGS")" ]; then
    if edit_hooks_json "$CLAUDE_SETTINGS" add "$(claude_hook_spec)"; then
      echo "Claude:   hooks in $CLAUDE_SETTINGS report when it stops on a prompt"
    else
      echo "Claude:   couldn't update $CLAUDE_SETTINGS (is it valid JSON?)" >&2
    fi
  else
    echo "Claude:   not found, skipped."
  fi
  command -v codex >/dev/null 2>&1 || return 0
  while IFS= read -r home; do
    if edit_hooks_json "$home/hooks.json" add "$(codex_hook_spec)"; then
      echo "Codex:    hooks in $home/hooks.json report when it stops on a prompt"
    else
      echo "Codex:    couldn't update $home/hooks.json (is it valid JSON?)" >&2
    fi
  done < <(codex_homes)
  echo "          Codex asks you to review new hooks once (/hooks in a Codex session); Superset's Codex runs them as is."
}

# --- Remote Control (Claude Code's own: claude.ai/code and the Claude app reach a session here) ---

# The Claude Code settings file: $CLAUDE_CONFIG_DIR's, else one integrate recorded (the app doesn't
# inherit a custom CLAUDE_CONFIG_DIR), else ~/.claude's
claude_settings_file() {
  if [ -z "${CLAUDE_CONFIG_DIR:-}" ]; then
    local f; f="$(grep -v '/hooks\.json$' "$HOOK_FILES" 2>/dev/null | head -1)"
    if [ -n "$f" ]; then echo "$f"; return 0; fi
  fi
  echo "$CLAUDE_SETTINGS"
}

remote_on() { [ "$(plutil -extract remoteControlAtStartup raw -o - "$(claude_settings_file)" 2>/dev/null)" = "true" ]; }

# "pid yes|no" per busy Claude Code session (or one that needs input): is it on Remote Control? Claude
# Code keeps a sessions/<pid>.json per running session, with a bridgeSessionId while it's connected.
# That file is undocumented, so a session without one (an older version) is left out, not flagged.
remote_sessions() {   # remote_sessions [agent report]
  local report="${1-$(agent_report)}" dir pid name f
  dir="$(dirname "$(claude_settings_file)")/sessions"
  printf '%s\n' "$report" | while read -r pid name _; do
    [ "$name" = "claude" ] && [ -f "$dir/$pid.json" ] || continue
    f="$dir/$pid.json"
    [ "$(plutil -extract kind raw -o - "$f" 2>/dev/null)" = "interactive" ] || continue
    if plutil -extract bridgeSessionId raw -o - "$f" >/dev/null 2>&1; then echo "$pid yes"; else echo "$pid no"; fi
  done
}

# "pid folder" per busy Claude Code session that isn't on Remote Control
remote_missing() {   # remote_missing [agent report]
  local pid
  remote_sessions "$@" | awk '$2 == "no" { print $1 }' | while read -r pid; do echo "$pid $(agent_folder "$pid")"; done
}

# "claude in a, claude in b": the busy sessions remote_missing printed
remote_missing_names() { awk '{ $1 = ""; sub(/^ /, ""); n = split($0, p, "/"); printf "%sclaude in %s", (NR > 1 ? ", " : ""), (p[n] == "" ? "?" : p[n]) }'; }

# agents remote [on|off]: Claude Code's Remote Control for every new session, so you can answer an
# agent from your phone with the lid closed. A session that's already running can only connect from
# inside it (/remote-control), so this also names busy ones that aren't connected.
cmd_remote() {
  local file missing; file="$(claude_settings_file)"
  case "${1:-}" in
    on)
      # Push when one needs you, unless you've chosen otherwise in /config
      set_claude_settings "$file" remoteControlAtStartup=true '?inputNeededNotifEnabled=true' ||
        { echo "agents: couldn't update $file (is it valid JSON?)" >&2; exit 1; }
      log "remote control: on"
      echo "Remote Control: on. New Claude Code sessions connect, and the Claude app gets a push when one needs you." ;;
    off)
      set_claude_settings "$file" remoteControlAtStartup=false ||
        { echo "agents: couldn't update $file (is it valid JSON?)" >&2; exit 1; }
      log "remote control: off"
      echo "Remote Control: off for new Claude Code sessions. Connected ones stay on until you run /remote-control in them."
      return 0 ;;
    "")
      if remote_on; then
        echo "Remote Control: on for new Claude Code sessions"
        echo "  agents remote off · answer them at claude.ai/code or in the Claude app"
      else
        echo "Remote Control: off for new Claude Code sessions"
        echo "  agents remote on     new sessions connect, so you can answer them from your phone"
      fi ;;
    *) echo "agents: use agents remote, agents remote on or agents remote off" >&2; exit 1 ;;
  esac
  missing="$(remote_missing)"
  if [ -n "$missing" ]; then
    echo "  Busy and not on Remote Control: $(printf '%s\n' "$missing" | remote_missing_names)."
    echo "  Run /remote-control in each to reach it from your phone."
  fi
}

# agents wait [minutes]: how long a closed Mac stays awake for an agent that needs input.
# The same setting as the menu bar's "Wait for your answer"; a running keep picks it up.
cmd_wait() {
  local m="${1:-}"
  if [ -z "$m" ]; then
    echo "A closed Mac stays awake $(wait_minutes) min for an agent that needs you, then sleeps."
    echo "  change it: agents wait 10   (minutes; also the cup → Settings → Wait for your answer)"
    return 0
  fi
  m="${m%m}"; m="${m%min}"
  case "$m" in ''|*[!0-9]*) echo "agents: minutes must be a whole number, got '$1'" >&2; exit 1 ;; esac
  defaults write "$BUNDLE_ID" WaitMinutes -int "$m"
  echo "A closed Mac now stays awake $m min for an agent that needs you."
}

cmd_integrate() {
  # --refresh: quiet upgrade step, run by install.sh and the app at launch; changes nothing new
  if [ "${1:-}" = "--refresh" ]; then
    refresh_opencode_plugin
    # bring our hooks up to date where they're installed (a no-op unless an upgrade changed them)
    local f
    while IFS= read -r f; do
      grep -qF "$HOOK_TAG" "$f" 2>/dev/null || continue
      case "$f" in */hooks.json) edit_hooks_json "$f" add "$(codex_hook_spec)" ;; *) edit_hooks_json "$f" add "$(claude_hook_spec)" ;; esac
    done < <(hook_files)
    return 0
  fi

  # Codex: its own prevent_idle_sleep feature holds a sleep assertion in the codex process
  # for exactly as long as a turn runs (interactive sessions; `codex exec` doesn't take one,
  # but its child processes' CPU still counts). Apps can launch Codex with their own
  # CODEX_HOME (Superset does for extra accounts), so switch it on in every home we find.
  if command -v codex >/dev/null 2>&1; then
    local home ok=0
    while IFS= read -r home; do
      if CODEX_HOME="$home" codex features enable prevent_idle_sleep >/dev/null 2>&1; then
        echo "Codex:    prevent_idle_sleep is on in $home"
        ok=1
      else
        echo "Codex:    couldn't switch it on in $home. Run:  CODEX_HOME='$home' codex features enable prevent_idle_sleep" >&2
      fi
    done < <(codex_homes)
    if [ "$ok" = 1 ]; then
      echo "          Codex now marks itself busy while a turn runs. Restart open sessions to pick it up."
    fi
  else
    echo "Codex:    not found on PATH, skipped."
  fi

  # OpenCode: a plugin that holds caffeinate while any session is busy
  if command -v opencode >/dev/null 2>&1 || [ -d "$(dirname "$(dirname "$OPENCODE_PLUGIN")")" ]; then
    if [ ! -f "$OPENCODE_PLUGIN_SRC" ]; then
      echo "OpenCode: plugin missing from this install ($OPENCODE_PLUGIN_SRC)" >&2
    else
      mkdir -p "$(dirname "$OPENCODE_PLUGIN")"
      cp "$OPENCODE_PLUGIN_SRC" "$OPENCODE_PLUGIN"
      echo "OpenCode: installed $OPENCODE_PLUGIN"
      echo "          Sessions already open pick it up when you restart them."
    fi
  else
    echo "OpenCode: not found, skipped."
  fi
  # Claude Code and Codex: hooks that mark an agent stopped on a prompt as "needs input"
  integrate_hooks

  # Claude Code: Remote Control for new sessions, unless you've already chosen either way
  if command -v claude >/dev/null 2>&1 || [ -d "$(dirname "$CLAUDE_SETTINGS")" ]; then
    if ! set_claude_settings "$(claude_settings_file)" '?remoteControlAtStartup=true' '?inputNeededNotifEnabled=true'; then
      echo "Remote:   couldn't update $(claude_settings_file) (is it valid JSON?)" >&2
    elif remote_on; then
      echo "Remote:   new Claude Code sessions connect to Remote Control, so you can answer them from your phone"
      echo "          (agents remote off to stop). Sessions already open: run /remote-control in them."
    else
      echo "Remote:   off for new Claude Code sessions, as you chose (agents remote on)"
    fi
  fi

  touch "$STATE_DIR/integrated"      # install.sh stops suggesting `agents integrate`
  log "integrate"
}

cmd_uninstall() {
  if keeping && has_sudo_rule; then cmd_pause >/dev/null; fi
  stop_guard
  pkill -x LidAgents 2>/dev/null
  rm -f "$LAUNCH_AGENT"
  if [ -f "$SUDOERS_FILE" ]; then as_root "rm -f '$SUDOERS_FILE'" && echo "Removed $SUDOERS_FILE"; fi
  if [ -f "$OPENCODE_PLUGIN" ]; then rm -f "$OPENCODE_PLUGIN" && echo "Removed $OPENCODE_PLUGIN"; fi
  local f
  while IFS= read -r f; do
    if grep -qF "$HOOK_TAG" "$f" 2>/dev/null; then
      edit_hooks_json "$f" remove && echo "Removed the Lid Agents hooks from $f"
    fi
  done < <(hook_files)
  if [ -L "$LINK" ]; then rm -f "$LINK"; fi
  if [ -n "$APP_BUNDLE" ] && [ -d "$APP_BUNDLE" ]; then rm -rf "$APP_BUNDLE" && echo "Removed $APP_BUNDLE"; fi
  # A Claude Code setting, which you may want either way, so it's left as it is
  if remote_on; then
    echo "Claude Code still connects new sessions to Remote Control. To stop: /config in Claude Code → Enable Remote Control for all sessions."
  fi
  rm -rf "$STATE_DIR"
  echo "Lid Agents is uninstalled. Closing the lid sleeps the Mac as normal."
  if command -v codex >/dev/null 2>&1; then
    local home header=0
    while IFS= read -r home; do
      codex_sleep_feature_on "$home" || continue
      if [ "$header" = 0 ]; then
        echo "Codex's prevent_idle_sleep is still on (a Codex setting that \`agents integrate\` switched on). To turn it off:"
        header=1
      fi
      echo "  CODEX_HOME='$home' codex features disable prevent_idle_sleep"
    done < <(codex_homes)
  fi
}

case "${1:-status}" in
  keep|on)    shift; cmd_keep "$@" ;;
  pause|off)  cmd_pause ;;
  toggle)     if keeping; then cmd_pause; else shift; cmd_keep "$@"; fi ;;
  status)     cmd_status ;;
  state)      shift; cmd_state "$@" ;;
  busy)       cmd_busy ;;
  mark)       shift; cmd_mark "$@" ;;
  install)    cmd_install ;;
  integrate)  shift; cmd_integrate "$@" ;;
  hotkey)     shift; cmd_hotkey "$@" ;;
  wait)       shift; cmd_wait "$@" ;;
  remote)     shift; cmd_remote "$@" ;;
  uninstall)  cmd_uninstall ;;
  update)     cmd_update ;;
  version|--version|-v) echo "lid-agents $AGENTS_VERSION" ;;
  *) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; [ "${1:-}" = "help" ] || [ "${1:-}" = "--help" ] || exit 1 ;;
esac
